<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>Vackle</AssemblyName>
        <RootNamespace>Vackle</RootNamespace>
        <AssemblyTitle>Vackle</AssemblyTitle>
        <Description>Vackle launcher and installer for Flackle</Description>
        <ApplicationIcon>assets\vackle.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests/**" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Numerics" />
        <Reference Include="System.Windows.Forms" />
        <Reference Include="System.Drawing" />
        <EmbeddedResource Include="assets\adguard.js" LogicalName="adguard.js" />
        <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
    </ItemGroup>
</Project>
